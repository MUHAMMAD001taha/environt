# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform.
# Get an API Key: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_KEY"
VITE_GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configurations for booking emails (DEPRECATED):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# RESEND_API_KEY: Required for email notifications.
# Get an API Key: https://resend.com/
RESEND_API_KEY=

# ADMIN_PASSWORD: Required for accessing the admin dashboard.
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# FIREBASE_SERVICE_ACCOUNT_JSON: Your service account key JSON from Firebase console
# Generate one at: Project Settings -> Service Accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# FIREBASE_DATABASE_ID: The Firestore database name (defaults to "(default)" when a service account is used)
# FIREBASE_DATABASE_ID="(default)"

